# Copy to .env and fill in your own key. .env is gitignored; this file is not.

# Groq API key - get one free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Which chat model the agent drives, as "provider:model".
# Groq retires model IDs without notice; if you get a 404 "model_not_found",
# pick a current tool-calling model from https://console.groq.com/docs/models
HOUSE_AGENT_MODEL=groq:openai/gpt-oss-120b

# To use a different provider instead, install its package and point at it, e.g.
#   pip install langchain-anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#   HOUSE_AGENT_MODEL=anthropic:claude-opus-5
